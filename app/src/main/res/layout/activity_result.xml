<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_resultat_ia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#16803C">

    <TextView
        android:id="@+id/txt_titre_ia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titre_verdict"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="35dp"/>

    <TextView
        android:id="@+id/txt_resultat_ia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/resultat_defaut"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_nouveau_ia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_nouveau_voyageur"
        android:textColor="#17365D"
        android:backgroundTint="#FFFFFF"/>

</LinearLayout>